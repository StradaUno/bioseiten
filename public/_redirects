# viuno — Cloudflare Pages redirects
# Publish-Verzeichnis ist `public/`, deshalb liegt diese Datei hier
# (Cloudflare Pages liest `_redirects` nur aus dem Build-Output-Root).

# ── SPA unter /app/ ─────────────────────────────────────────────
# Der Router ist hash-basiert, die Regel fängt nur Deep-Links wie
# /app/irgendwas ab, damit dort kein 404 entsteht.
/app/*        /app/index.html        200

# ── Legal-Seiten: alles auf /legal mit Anker ──────────────────────
# Die Texte stehen in legal_texts und werden von /legal ausgeliefert.
# Die frueheren Einzelseiten zogen ihren Inhalt aus itrk.legal und waren
# durch ein 404 dort dauerhaft leer.
/impressum.html     /legal#impressum      301
/datenschutz.html   /legal#datenschutz    301
/agb.html           /legal#agb            301
/widerruf.html      /legal#widerruf       301

# ── Geteilte Analyse-Ausschnitte ────────────────────────────────────
# /analyse/<token> ist keine Datei, sondern eine Seite, die ihren Token aus
# dem Pfad liest. Jede Freigabe hat einen eigenen Token, deshalb ueberschreibt
# eine neue Analyse den Link der vorherigen nicht.
/analyse/*    /analyse/index.html    200

# ── Hilfe ─────────────────────────────────────────────────────────
/hilfe        /faq/    301
/faq          /faq/    301
